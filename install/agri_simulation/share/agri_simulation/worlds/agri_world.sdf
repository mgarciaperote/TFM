<?xml version="1.0" ?>
<sdf version="1.10">

  <world name="agri_world">

    <physics name="physics" type="gz-physics">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>

      <link name="ground_link">

        <collision name="collision">
          <geometry>
            <box>
              <size>30 20 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30 20 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.35 0.18 0.08 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <model name="crop_row_1">
      <static>true</static>
      <pose>0 -4 0.15 0 0 0</pose>

      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.5 0.3</size>
            </box>
          </geometry>

          <material>
            <ambient>0.05 0.5 0.05 1</ambient>
            <diffuse>0.1 0.7 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="crop_row_2">
      <static>true</static>
      <pose>0 0 0.15 0 0 0</pose>

      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.5 0.3</size>
            </box>
          </geometry>

          <material>
            <ambient>0.05 0.5 0.05 1</ambient>
            <diffuse>0.1 0.7 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="crop_row_3">
      <static>true</static>
      <pose>0 4 0.15 0 0 0</pose>

      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.5 0.3</size>
            </box>
          </geometry>

          <material>
            <ambient>0.05 0.5 0.05 1</ambient>
            <diffuse>0.1 0.7 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>

</sdf>